# ── App ───────────────────────────────────────────────────────────────────────
ENVIRONMENT=development                 # development | staging | production
CORS_ORIGINS=http://localhost:3000
DEV_BYPASS_AUTH=false                   # never true in staging/production
REQUIRE_HUMAN_ON_ALL=false              # four-eyes master switch (forces human sign-off)

# ── Service-to-service auth ───────────────────────────────────────────────────
# Shared secret presented as X-Service-Key by n8n (→ this shim) and by this shim
# (→ P3/P2). Generate a long random value; store only in Railway/n8n secrets.
AGENT_FLOW_SERVICE_KEY=

# ── Approvers (private demo) ──────────────────────────────────────────────────
# Comma-separated Supabase user ids allowed to run the pipeline as a person and to
# approve/reject. Empty = nobody (fail closed). Everyone else who signs in sees
# only runs they own. Locally with DEV_BYPASS_AUTH, add the placeholder id
# 00000000-0000-0000-0000-000000000000 to approve from the dev page.
APPROVER_USER_IDS=

# ── Upstream tools (the shim proxies these) ───────────────────────────────────
DOCI_BASE_URL=https://dome-document-intelligence-staging.up.railway.app
LLC_BASE_URL=https://dome-llm-council-staging.up.railway.app

# ── n8n resume (human gate) ───────────────────────────────────────────────────
# Base URL the shim calls to resume a paused n8n Wait node after an approval.
N8N_RESUME_BASE_URL=

# ── Supabase (run state + governance events) ──────────────────────────────────
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ── Sentry (optional) ─────────────────────────────────────────────────────────
SENTRY_DSN=
